<?xml version="1.0" encoding="utf-8"?>
<!--
    Record Labs launcher icon (static/non-dynamic-color variant): same vinyl-record mark as
    ic_launcher_foreground.xml, used when "Dynamic icon colors" is disabled in settings.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vinyl disc -->
    <path
        android:fillColor="#FF1A1A1A"
        android:pathData="M54,24 A30,30 0 1,1 53.99,24 Z" />

    <!-- Groove rings -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF3A3A3A"
        android:strokeWidth="1.1"
        android:pathData="M54,31 A23,23 0 1,1 53.99,31 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF3A3A3A"
        android:strokeWidth="1"
        android:pathData="M54,37 A17,17 0 1,1 53.99,37 Z" />

    <!-- Center label -->
    <path
        android:fillColor="#FFF2795C"
        android:pathData="M54,43 A11,11 0 1,1 53.99,43 Z" />

    <!-- Spindle hole -->
    <path
        android:fillColor="#FFEDE9E3"
        android:pathData="M54,52 A2,2 0 1,1 53.99,52 Z" />

    <!-- Music-note flourishes -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1A1A1A"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M64,26 q6,-8 12,-3" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1A1A1A"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M74,33 q6.5,-8.5 12.5,-3" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1A1A1A"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M57,18 q5.5,-7.5 11,-2.5" />
</vector>
